{
    "version": "2.8.2",
    "description": "A feature rich FOSS PlayStation 2 emulator",
    "homepage": "https://pcsx2.net/",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://github.com/PCSX2/pcsx2/blob/master/COPYING.GPLv3"
    },
    "notes": [
        "ATTENTION: PCSX2 requires a dump of the PS2 BIOS to function.",
        "Place the BIOS file in $persist_dir\\bios",
        "Learn more at https://pcsx2.net/docs/setup/bios"
    ],
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/PCSX2/pcsx2/releases/download/v2.8.2/pcsx2-v2.8.2-windows-x64-Qt.7z",
            "hash": "7dfc829ca1994cc1045ac49f05e39b6cf968b72e6a374c40e05c2a2b4ac200b4"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-Item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   if (Test-Path \"$env:USERPROFILE\\Documents\\PCSX2\") {",
        "       Write-Host \"Migrating AppData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:USERPROFILE\\Documents\\PCSX2\\*\" -Destination \"$persist_dir\" -Recurse",
        "       New-Item \"$persist_dir\\inis\\PCSX2.ini\" -Force -Value (((Get-Content \"$persist_dir\\inis\\PCSX2.ini\" -Encoding utf8) -notmatch '^CheckAtStartup') + '[AutoUpdater]', 'CheckAtStartup = false' | Out-String) | Out-Null",
        "       Remove-Item -Path \"$env:USERPROFILE\\Documents\\PCSX2\" -Recurse",
        "   } else {",
        "       New-Item \"$persist_dir\\inis\" -ItemType Directory | Out-Null",
        "       '[UI]', 'SettingsVersion = 1', 'SetupWizardIncomplete = true', '[AutoUpdater]', 'CheckAtStartup = false' | Set-Content \"$persist_dir\\inis\\PCSX2.ini\"",
        "   }",
        "}"
    ],
    "post_install": "New-Item \"$dir\\portable.ini\" -ItemType File | Out-Null",
    "bin": [
        [
            "pcsx2-qt.exe",
            "pcsx2"
        ]
    ],
    "shortcuts": [
        [
            "pcsx2-qt.exe",
            "PCSX2"
        ]
    ],
    "persist": [
        "bios",
        "cache",
        "cheats",
        "covers",
        "gamesettings",
        "inis",
        "inputprofiles",
        "logs",
        "memcards",
        "patches",
        "snaps",
        "sstates",
        "textures",
        "videos"
    ],
    "checkver": {
        "github": "https://github.com/PCSX2/pcsx2/"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/PCSX2/pcsx2/releases/download/v$version/pcsx2-v$version-windows-x64-Qt.7z"
            }
        }
    }
}
