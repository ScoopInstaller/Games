{
    "version": "20261119133638-1c35b9b",
    "description": "PlayStation 4 emulator",
    "homepage": "https://shadps4.net/",
    "license": {
        "identifier": "GPL-2.0-only",
        "url": "https://github.com/shadps4-emu/shadps4-qtlauncher/blob/main/LICENSE"
    },
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/shadps4-emu/shadps4-qtlauncher/releases/download/shadPS4QtLauncher-2026-11-19-1c35b9b147a8e67474fba6500bdfc309bef6f8e1/shadPS4QtLauncher-win64-qt-2026-11-19-1c35b9b.zip",
            "hash": "937b71b9643a554de8411bd424fc14bdf52624f7b63d971412aa801dec9aa4ec"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "    New-Item \"$persist_dir\" -ItemType Directory | Out-Null",
        "    $map = @{ 'shadPS4' = 'user'; 'shadPS4QtLauncher' = 'launcher' }",
        "    $paths = @{ 'shadPS4' = 'addcont'; 'shadPS4QtLauncher' = 'versions' }",
        "    $found = $map.Keys.Where({ Test-Path \"$env:APPDATA\\$_\" })",
        "    if ($found) {",
        "        Write-Host 'Migrating AppData...' -ForegroundColor Yellow",
        "        foreach ($folder in $found) {",
        "            $dest = \"$persist_dir\\$($map[$folder])\"",
        "            New-Item $dest -ItemType Directory | Out-Null",
        "            Copy-Item -Path \"$env:APPDATA\\$folder\\*\" -Destination $dest -Recurse",
        "            Remove-Item -Path \"$env:APPDATA\\$folder\" -Recurse",
        "            # The files store paths both with escaped backslashes and with forward slashes",
        "            $from, $to = \"$env:APPDATA\\$folder\\$($paths[$folder])\", \"$(Split-Path $dir)\\current\\$($map[$folder])\\$($paths[$folder])\"",
        "            Get-ChildItem \"$dest\\*\" -Include config.json, qt_ui.ini, versions.json | ForEach-Object {",
        "                (Get-Content -Path $_.FullName -Encoding UTF8).Replace($from.Replace('\\', '\\\\'), $to.Replace('\\', '\\\\')).Replace($from.Replace('\\', '/'), $to.Replace('\\', '/')) | Set-Content -Path $_.FullName -Encoding UTF8",
        "            }",
        "        }",
        "        (Get-Content -Path \"$persist_dir\\launcher\\qt_ui.ini\" -Encoding UTF8).Replace('checkForUpdates=true', 'checkForUpdates=false') | Set-Content -Path \"$persist_dir\\launcher\\qt_ui.ini\" -Encoding UTF8",
        "    }",
        "}"
    ],
    "bin": [
        [
            "shadPS4QtLauncher.exe",
            "shadPS4"
        ]
    ],
    "shortcuts": [
        [
            "shadPS4QtLauncher.exe",
            "shadPS4"
        ]
    ],
    "persist": [
        "launcher",
        "user"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/shadps4-emu/shadps4-qtlauncher/releases",
        "script": [
            "$release = (ConvertFrom-Json $page)[0]",
            "$time = ([datetime]$release.published_at).ToUniversalTime().ToString('yyyyMMddHHmmss')",
            "Write-Output \"$time $($release.tag_name) $($release.name)\""
        ],
        "regex": "(?<time>\\d{14}) (?<tag>\\S+) shadPS4QtLauncher-(?<build>[\\d-]+-(?<commit>[a-f\\d]+))",
        "replace": "${time}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/shadps4-emu/shadps4-qtlauncher/releases/download/$matchTag/shadPS4QtLauncher-win64-qt-$matchBuild.zip"
            }
        }
    }
}
