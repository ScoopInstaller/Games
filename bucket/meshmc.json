{
    "version": "12.0",
    "description": "An open source Minecraft launcher with the ability to manage multiple instances, accounts and mods.",
    "homepage": "https://projecttick.org/",
    "license": "Apache-2.0,MS-PL",
    "url": "https://github.com/Project-Tick/MeshMC-Archive/releases/download/build-22/MeshMC-build-22-win32.zip",
    "hash": "180e65d65102305c43bc08531bf0cac9547a0f98b39171352396107919e0e094",
    "extract_dir": "MeshMC",
    "pre_install": [
        "New-Item -Path \"$dir\\portable.txt\" -ItemType File -Force | Out-Null",
        "$contents = @{",
        "    'accounts.json' = '{}'",
        "    'metacache' = '{}'",
        "    'meshmc.cfg' = ''",
        "}",
        "'accounts.json', 'metacache', 'meshmc.cfg' | ForEach-Object {",
        "    if (Test-Path \"$persist_dir\\$_\") {",
        "        Copy-Item \"$persist_dir\\$_\" \"$dir\\$_\" -Force",
        "    } elseif (!(Test-Path \"$dir\\$_\")) {",
        "        Set-Content -Path \"$dir\\$_\" -Value $contents[$_] -Encoding Ascii",
        "    }",
        "}"
    ],
    "bin": "MeshMC.exe",
    "shortcuts": [
        [
            "MeshMC.exe",
            "MeshMC"
        ]
    ],
    "persist": [
        "assets",
        "cache",
        "catpacks",
        "icons",
        "iconthemes",
        "instances",
        "java",
        "libraries",
        "logs",
        "meta",
        "plugin-data",
        "mods",
        "skins",
        "themes",
        "translations"
    ],
    "pre_uninstall": [
        "# Hardlinks cannot work properly here, as this app would create a new file instead of writing directly.",
        "# Please keep the file list the same in both pre_install and pre_uninstall scripts.",
        "'accounts.json', 'metacache', 'meshmc.cfg' | ForEach-Object {",
        "    if (Test-Path -Path \"$dir\\$_\") {",
        "        Copy-Item -Path \"$dir\\$_\" -Destination \"$persist_dir\\$_\" -Force",
        "    }",
        "}"
    ]
}
